data/quarantine/

# MLflow and Experiment Tracking
mlruns/
mlflow.db
mlflow.db-journal
.trash/

# Logs and runtime artifacts
logs/*
!logs/.gitkeep
*.log
data/enterprise_db/
*.db

# Large Datasets (Medallion Architecture - Excluded from Git tracking)
# Raw, Silver, and Gold data are generated deterministically via reproducible pipeline
data/raw/*
!data/raw/.gitkeep
data/silver/*
!data/silver/.gitkeep
data/gold/*
!data/gold/.gitkeep
*.csv
*.parquet
*.xlsx
*.tsv

# Binary Models and Weights (Excluded from Git tracking)
# Models are trained deterministically via 'make train' (seed=42) or pulled from MLflow Registry
models/*.joblib
models/*.pkl
models/*.onnx
models/*.pt
models/*.pth
models/*.bin
models/*.h5
models/*.png
!models/.gitkeep
!models/model_benchmark.json

# Reports and temporary images
reports/figures/*
!reports/figures/.gitkeep
